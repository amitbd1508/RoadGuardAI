# RoadGuard AI Environment Variables
# No cloud API keys are required for normal offline vehicle operation!

# Hardware Port Overrides (optional)
# GPS_SERIAL_PORT=/dev/ttyACM0
# GPS_BAUD_RATE=9600

# Piper TTS Binary / Model Paths (optional overrides)
# PIPER_BINARY_PATH=/usr/local/bin/piper
# PIPER_MODEL_PATH=/opt/roadguard/models/en_US-lessac-medium.onnx

# Dashboard Server Binding
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
LOG_LEVEL=INFO
